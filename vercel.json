{
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/work", "destination": "/pages/work/index.html" },
    { "source": "/work/:project", "destination": "/pages/work/:project/index.html" },
    { "source": "/design", "destination": "/pages/design/design-role/index.html" },
    { "source": "/design-archive", "destination": "/pages/design/index.html" },
    { "source": "/it", "destination": "/pages/design/it/index.html" },
    { "source": "/ai-lab", "destination": "/pages/ai-lab/index.html" },
    { "source": "/blog", "destination": "/pages/blog/index.html" },
    { "source": "/blog/:post", "destination": "/pages/blog/:post/index.html" },
    { "source": "/toolbox", "destination": "/pages/toolbox/index.html" },
    { "source": "/resume", "destination": "/pages/resume/index.html" },
    { "source": "/:path*", "destination": "/pages/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/public/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pages/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
